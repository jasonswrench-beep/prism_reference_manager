{
  "manifest_version": 3,
  "name": "Prism Reference Manager capture",
  "short_name": "Prism capture",
  "version": "0.1.0",
  "description": "Save the paper on the current page, with its details and PDF, to Prism Reference Manager on this computer for review.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Save to Prism Reference Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Save the current page" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
